# Copy to .env.local and fill in what you need. Never commit real values.

# Product name shown in the UI (public).
NEXT_PUBLIC_APP_NAME=CreateStudio

# --- Cloud AI (optional). Keys stay on the server; the browser only learns whether a feature is available. ---
# Enables text-to-image, generative edit and speech-to-text subtitles.
OPENAI_API_KEY=
# Optional overrides
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Preferred provider id when several are configured.
AI_PROVIDER=openai
# AI requests allowed per client IP per minute.
AI_RATE_LIMIT_PER_MIN=10

# --- Accounts and cloud sync (planned, see DEVELOPMENT_PROGRESS.md). ---
# DATABASE_URL=postgresql://user:password@localhost:5432/createstudio
# SESSION_SECRET=generate-with: openssl rand -base64 32
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
